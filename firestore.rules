rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // true solo si el usuario logueado tiene un documento en /admins/{su uid}
    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Cada usuario solo puede leer SU PROPIO documento de admin
    // (así el panel puede chequear "¿soy admin?"). Nadie puede escribir acá
    // desde el cliente: esos documentos se crean a mano en la consola.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // El catálogo lo tiene que poder LEER cualquiera (es la tienda pública),
    // pero solo un admin logueado puede crear/editar/borrar productos.
    match /productos/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Cualquiera puede CREAR un pedido (cliente pidiendo por WhatsApp),
    // pero solo un admin puede verlos, editarlos o borrarlos.
    match /pedidos_nexo/{id} {
      allow create: if true;
      allow read, update, delete: if esAdmin();
    }

    // Clientes (vencimientos) — solo admin.
    match /clientes/{id} {
      allow read, write: if esAdmin();
    }
  }
}
